{
  "configs": [
    {
      "title": "音乐标签工作台",
      "config": "config.json",
      "preferences": [
        {
          "type": "button",
          "title": "打开音乐标签工作台",
          "summary": "进入工作台主视图：批量处理匹配歌词、匹配封面、匹配艺术家，查看歌曲频谱、逐字打轴等",
          "arrow_type": "arrow",
          "on_click": "io.github.univers629.spwtagworkbench.MainPlugin.openWorkbench"
        },
        {
          "type": "list",
          "key": "matching.policy",
          "title": "批量匹配时的已有标签策略",
          "summary": "全部重新匹配：用在线数据覆盖完整标签；仅补缺失：完整标签整首跳过",
          "entries": [
            "全部重新匹配",
            "仅补缺失"
          ],
          "entry_values": [
            "refill",
            "fill"
          ],
          "default_value": "fill"
        },
        {
          "type": "switch",
          "key": "sidebar.rail",
          "title": "显示侧栏悬浮按钮",
          "summary": "窗口右侧的全局侧边栏召唤按钮",
          "default": true
        },
        {
          "type": "switch",
          "key": "view.showArtistSlots",
          "title": "工作台主视图显示艺术家封面",
          "summary": "关闭后主封面下方不再显示艺术家封面槽位",
          "default": true
        },
        {
          "type": "button",
          "title": "开源项目",
          "summary": "查看源代码、使用说明与问题反馈",
          "arrow_type": "arrow",
          "on_click": "io.github.univers629.spwtagworkbench.MainPlugin.openSourcePage"
        }
      ]
    }
  ]
}
